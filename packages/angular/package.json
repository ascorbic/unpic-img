{
  "name": "@unpic/angular",
  "version": "1.0.0",
  "description": "A high-performance, responsive image module and directive for Angular",
  "keywords": [
    "angular",
    "images"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && publint",
    "watch": "ng build --watch --configuration development"
  },
  "files": [
    "dist"
  ],
  "module": "dist/fesm2022/unpic-angular.mjs",
  "typings": "dist/types/unpic-angular.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/types/unpic-angular.d.ts",
      "default": "./dist/fesm2022/unpic-angular.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ascorbic/unpic-img",
    "directory": "packages/angular"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler": "^21.0.3",
    "@angular/compiler-cli": "^21.0.3",
    "@angular/core": "^21.0.3",
    "ng-packagr": "^21.0.0",
    "publint": "^0.3.2",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@unpic/core": "workspace:^",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0"
  }
}