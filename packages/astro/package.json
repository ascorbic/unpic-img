{
  "name": "@unpic/astro",
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "description": "A high-performance, responsive image service and component library for Astro",
  "repository": {
    "type": "git",
    "url": "https://github.com/ascorbic/unpic-img",
    "directory": "packages/astro"
  },
  "homepage": "https://unpic.pics/img/astro",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    }
  },
  "files": [
    "dist",
    "components"
  ],
  "keywords": [
    "astro",
    "withastro",
    "images",
    "astro-component"
  ],
  "scripts": {
    "build": "tsup && astro-check",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@testing-library/dom": "^10.4.0",
    "@types/jsdom": "^28.0.3",
    "astro": "^5.1.7",
    "jsdom": "^27.2.0",
    "tsup": "^8.3.5",
    "vitest": "^3.0.2"
  },
  "dependencies": {
    "@unpic/core": "workspace:^",
    "@unpic/pixels": "^1.3.0",
    "@unpic/placeholder": "^0.1.2",
    "blurhash": "^2.0.5"
  },
  "peerDependencies": {
    "astro": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0-beta"
  }
}